NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mycoo?schema=public

JWT_SECRET=change_me_strong_secret
JWT_EXPIRES_IN=15m

BCRYPT_SALT_ROUNDS=15

CODE_TTL_SECONDS=300
CODE_RESEND_COOLDOWN_SECONDS=30
CODE_MAX_ATTEMPTS=5

REDIS_URL=redis://:password@localhost:6379

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MyCOO <no-reply@mycoo.io>"
APP_URL=https://mycoo.io

# Authorization key from GigaChat; server-only, never expose it in VITE_* variables.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_BASE_URL=https://api.giga.chat
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# Initial attempt plus up to five retries, within a total time budget.
GIGACHAT_MAX_RETRIES=5
GIGACHAT_REQUEST_TIMEOUT_MS=20000
GIGACHAT_TOTAL_TIMEOUT_MS=120000
GIGACHAT_RETRY_DELAY_MS=500
