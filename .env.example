NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mycoo?schema=public

JWT_SECRET=change_me_strong_secret
JWT_EXPIRES_IN=15m

BCRYPT_SALT_ROUNDS=15

CODE_TTL_SECONDS=300
CODE_RESEND_COOLDOWN_SECONDS=30
CODE_MAX_ATTEMPTS=5

REDIS_URL=redis://:password@localhost:6379

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MyCOO <no-reply@mycoo.io>"
APP_URL=https://mycoo.io

# OAuth apps: enable a provider by setting its ID and exact public API callback URL.
# Callback examples: https://YOUR_API_HOST/api/auth/oauth/yandex/callback and /vk/callback.
YANDEX_ID_CLIENT_ID=
YANDEX_ID_CLIENT_SECRET=
YANDEX_ID_REDIRECT_URI=
VK_ID_CLIENT_ID=
VK_ID_REDIRECT_URI=
# Test orders never accrue partner commission. For live payments set false and configure live Robokassa passwords.
ROBO_KASSA_TEST_MODE=true
# One-time bootstrap via npm run partner:admin; remove after creating the administrator.
PARTNER_ADMIN_LOGIN=
PARTNER_ADMIN_PASSWORD=
CALLS_SERVICE_URL=http://mycoo-calls:8000
# Must match the calls microservice. Generate a random secret with at least 32 characters.
CALLS_SERVICE_SECRET=

# Authorization key from GigaChat; server-only, never expose it in VITE_* variables.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
# Optional meeting-only override. Verified regression scenario: GigaChat-2-Max
# with GIGACHAT_REQUEST_TIMEOUT_MS=60000. Empty keeps GIGACHAT_MODEL.
GIGACHAT_MEETING_MODEL=
GIGACHAT_BASE_URL=https://api.giga.chat
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# Initial attempt plus up to five retries, within a total time budget.
GIGACHAT_MAX_RETRIES=5
GIGACHAT_REQUEST_TIMEOUT_MS=20000
GIGACHAT_TOTAL_TIMEOUT_MS=120000
GIGACHAT_RETRY_DELAY_MS=500
