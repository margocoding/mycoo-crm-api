// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  workspaces          WorkspaceMember[]
  ownedWorkspaces     Workspace[]        @relation("WorkspaceOwner")
  subscriptions       Subscription[]
  departments         DepartmentMember[]
  invitations         TeamInvitation[]   @relation("InvitedBy")
  taskAssignments     TaskAssignee[]
  assignedTasks       Task[]             @relation("TaskAssigner")
  createdTasks        Task[]             @relation("TaskCreator")
  notifications       Notification[]
  referralCode        String?            @unique @map("referral_code")
  trialStartedAt      DateTime?          @map("trial_started_at")
  pendingReferralDays Int                @default(0) @map("pending_referral_days")
  referrals           Referral[]         @relation("Referrer")
  referredBy          Referral?          @relation("ReferredUser")
  paymentOrders       PaymentOrder[]

  @@map("users")
}

model Workspace {
  id      String @id @default(cuid())
  ownerId String @map("owner_id")
  owner   User   @relation("WorkspaceOwner", fields: [ownerId], references: [id])

  // Онбординг - Компания
  company       String?
  industry      String?
  industryOther String? @map("industry_other")
  site          String?
  employees     String?
  managers      String?
  revenue       String?
  stage         String?

  // Онбординг - Собственник
  ownerName  String? @map("owner_name")
  ownerRole  String? @map("owner_role")
  roleOther  String? @map("role_other")
  ownerEmail String? @map("owner_email")

  // Онбординг - Цели
  goal      String?
  problem   String?
  priority1 String? @map("priority_1")
  priority2 String? @map("priority_2")
  priority3 String? @map("priority_3")

  // Статусы
  onboardingComplete      Boolean   @default(false) @map("onboarding_complete")
  diagnosticsComplete     Boolean   @default(false) @map("diagnostics_complete")
  onboardingStep          Int       @default(0) @map("onboarding_step")
  diagnosticsAnalysis     Json?     @map("diagnostics_analysis")
  diagnosticsProcessingAt DateTime? @map("diagnostics_processing_at")
  isActive                Boolean   @default(false) @map("is_active")

  // Даты
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  trialStartedAt DateTime? @map("trial_started_at")

  members            WorkspaceMember[]
  diagnosticsAnswers DiagnosticsAnswer[]
  departments        Department[]
  tasks              Task[]
  dashboardSnapshots DashboardSnapshot[]
  notifications      Notification[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  userId      String        @map("user_id")
  user        User          @relation(fields: [userId], references: [id])
  workspaceId String        @map("workspace_id")
  workspace   Workspace     @relation(fields: [workspaceId], references: [id])
  role        WorkspaceRole @default(TEAM_MEMBER)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, workspaceId])
  @@map("workspace_members")
}

enum WorkspaceRole {
  OWNER
  MANAGER
  TEAM_MEMBER
}

model DiagnosticsAnswer {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  questionId String  @map("question_id")
  opt        Int?
  text       String?
  skip       Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, questionId])
  @@map("diagnostics_answers")
}

model Subscription {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  activeUntil DateTime          @map("active_until")
  kind        SubscriptionKind  @default(PAID)
  plan        SubscriptionPlan?
  period      BillingPeriod?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, activeUntil])
  @@map("subscriptions")
}

enum SubscriptionKind {
  TRIAL
  PAID
}

enum SubscriptionPlan {
  START
  MISSION
  ENTERPRISE
}

enum BillingPeriod {
  MONTH
  YEAR
}

enum PaymentStatus {
  PENDING
  PAID
}

model Referral {
  id             String   @id @default(cuid())
  inviterId      String   @map("inviter_id")
  inviter        User     @relation("Referrer", fields: [inviterId], references: [id])
  referredUserId String   @unique @map("referred_user_id")
  referredUser   User     @relation("ReferredUser", fields: [referredUserId], references: [id])
  bonusDays      Int      @default(0) @map("bonus_days")
  discountPercent Int    @default(0) @map("discount_percent")
  discountOrder PaymentOrder? @relation("ReferralDiscount")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([inviterId])
  @@map("referrals")
}

model PaymentOrder {
  id                String           @id @default(cuid())
  userId            String           @map("user_id")
  user              User             @relation(fields: [userId], references: [id])
  plan              SubscriptionPlan
  orderId           Int              @unique @default(autoincrement())
  period            BillingPeriod
  amountKopecks     Int              @map("amount_kopecks")
  discountPercent  Int              @default(0) @map("discount_percent")
  referralDiscountId String?        @unique @map("referral_discount_id")
  referralDiscount Referral?        @relation("ReferralDiscount", fields: [referralDiscountId], references: [id])
  currency          String           @default("RUB")
  status            PaymentStatus    @default(PENDING)
  idempotencyKey    String           @map("idempotency_key")
  providerPaymentId String?          @unique @map("provider_payment_id")
  paidAt            DateTime?        @map("paid_at")
  createdAt         DateTime         @default(now()) @map("created_at")

  @@unique([userId, idempotencyKey])
  @@map("payment_orders")
}

enum DepartmentRole {
  CHIEF
  ADMIN
  WORKER
}

model Department {
  id              String             @id @default(cuid())
  workspaceId     String             @map("workspace_id")
  workspace       Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  createdAt       DateTime           @default(now()) @map("created_at")
  members         DepartmentMember[]
  invitations     TeamInvitation[]
  tasks           TaskDepartment[]
  taskAssignments TaskAssignee[]

  dashboardSnapshots DashboardSnapshot[]

  @@index([workspaceId])
  @@map("departments")
}

model DepartmentMember {
  id           String         @id @default(cuid())
  userId       String         @map("user_id")
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId String         @map("department_id")
  department   Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  role         DepartmentRole @default(WORKER)

  @@unique([departmentId, userId])
  @@index([userId])
  @@map("department_members")
}

model TeamInvitation {
  id           String         @id @default(cuid())
  email        String
  name         String?
  departmentId String         @map("department_id")
  department   Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  role         DepartmentRole
  invitedById  String         @map("invited_by_id")
  invitedBy    User           @relation("InvitedBy", fields: [invitedById], references: [id])
  tokenHash    String         @unique @map("token_hash")
  expiresAt    DateTime       @map("expires_at")
  acceptedAt   DateTime?      @map("accepted_at")
  revokedAt    DateTime?      @map("revoked_at")
  createdAt    DateTime       @default(now()) @map("created_at")

  @@index([departmentId, email])
  @@map("team_invitations")
}

model Task {
  id              String             @id @default(cuid())
  workspaceId     String             @map("workspace_id")
  workspace       Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  departments     TaskDepartment[]
  title           String
  startDate       DateTime           @map("start_date") @db.Date
  dueDate         DateTime           @map("due_date") @db.Date
  priority        String             @default("medium")
  status          String             @default("backlog")
  successCriteria String             @default("") @map("success_criteria")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  assignees       TaskAssignee[]
  assignedById    String?            @map("assigned_by_id")
  assignedBy      User?              @relation("TaskAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  assignedByRole  TaskAssigningRole? @map("assigned_by_role")
  createdById     String?            @map("created_by_id")
  createdBy       User?              @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  repeatDays      Int[]              @default([]) @map("repeat_days")
  nextRepeatAt    DateTime?          @map("next_repeat_at")
  repeatSourceId  String?            @map("repeat_source_id")
  repeatSource    Task?              @relation("TaskRepeats", fields: [repeatSourceId], references: [id], onDelete: SetNull)
  repeatInstances Task[]             @relation("TaskRepeats")
  repeatDate      DateTime?          @map("repeat_date") @db.Date
  notifications   Notification[]

  @@index([workspaceId, createdAt])
  @@index([nextRepeatAt])
  @@unique([repeatSourceId, repeatDate])
  @@map("tasks")
}

enum TaskAssigningRole {
  OWNER
  CHIEF
  ADMIN
}

enum NotificationKind {
  ROLE_CHANGED
  TASK_ASSIGNED
}

enum NotificationEmailStatus {
  PENDING
  SENT
  SKIPPED
  FAILED
}

model Notification {
  id           String                  @id @default(cuid())
  workspaceId  String                  @map("workspace_id")
  workspace    Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recipientId  String                  @map("recipient_id")
  recipient    User                    @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  kind         NotificationKind
  emailStatus  NotificationEmailStatus @default(PENDING) @map("email_status")
  emailSentAt  DateTime?               @map("email_sent_at")
  message      String
  taskId       String?                 @map("task_id")
  task         Task?                   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  departmentId String?                 @map("department_id")
  readAt       DateTime?               @map("read_at")
  createdAt    DateTime                @default(now()) @map("created_at")

  @@index([workspaceId, recipientId, createdAt, id])
  @@index([workspaceId, recipientId, readAt])
  @@index([emailStatus, id])
  @@map("notifications")
}

model TaskDepartment {
  taskId       String     @map("task_id")
  task         Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  departmentId String     @map("department_id")
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([taskId, departmentId])
  @@index([departmentId])
  @@map("task_departments")
}

model TaskAssignee {
  id           String     @id @default(cuid())
  taskId       String     @map("task_id")
  task         Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  departmentId String     @map("department_id")
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  email        String
  name         String?
  userId       String?    @map("user_id")
  user         User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([taskId, departmentId, email])
  @@index([departmentId])
  @@index([userId])
  @@index([email])
  @@map("task_assignees")
}

model DashboardSnapshot {
  scopeKey      String      @id @map("scope_key")
  workspaceId   String      @map("workspace_id")
  workspace     Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  departmentId  String?     @map("department_id")
  department    Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  analysis      Json?
  generatedAt   DateTime?   @map("generated_at")
  periodStart   DateTime?   @map("period_start") @db.Date
  periodEnd     DateTime?   @map("period_end") @db.Date
  processingAt  DateTime?   @map("processing_at")
  nextRefreshAt DateTime    @default(now()) @map("next_refresh_at")
  revision      Int         @default(0)

  @@index([nextRefreshAt])
  @@map("dashboard_snapshots")
}
